# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/

# Secrets / local editor + OS files
.env
.vscode
.DS_Store

# Databases. NOTE: data/snapshot.sqlite is already tracked (force-added), so this rule
# doesn't stop changes to it being committed - only new .sqlite files are ignored.
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Large / regenerable data
gtfs/
share/
data/bods_archive/
delay_engine/archival_data/traffic_data/
delay_engine/archival_data/roadwork_permits/
# pipeline outputs (the few files in here that are already tracked stay tracked)
delay_engine/trip_matching/out/

# Logs
*.out
*.log
nohup.out
